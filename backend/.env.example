# Local dev database started by `npm run db`. Production (Neon) URL is set only on Render.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/everest"
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
# AI chat assistant (Google Gemini, free tier). Get a key at https://aistudio.google.com → Get API key.
# Leave empty to switch the chat off.
GEMINI_API_KEY=""
# Optional: which Gemini model answers. Default gemini-flash-lite-latest.
# AI_MODEL="gemini-flash-lite-latest"
# Used when the first model hits its per-minute free limit.
# AI_FALLBACK_MODEL="gemini-3.1-flash-lite"
