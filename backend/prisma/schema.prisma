generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STORE
  PRODUCTION
  QC
  DISPATCH
}

enum Shift {
  MORNING
  EVENING
  NIGHT
}

enum Stage {
  SPINNING
  WEAVING
  DYEING
}

enum OrderStatus {
  PENDING
  SPINNING
  WEAVING
  DYEING
  QC
  READY
  DISPATCHED
  CANCELLED
}

enum MachineStatus {
  IDLE
  RUNNING
  BREAKDOWN
  MAINTENANCE
}

enum JobStatus {
  RUNNING
  COMPLETED
  STOPPED
}

enum RollStatus {
  PENDING_QC
  PASSED
  REWORK
  REJECTED
  DISPATCHED
}

enum QCResult {
  PASS
  REWORK
  REJECT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

// Yarn is what orders are made from; the rest is what the mill uses up along the way.
enum MaterialCategory {
  YARN
  DYE
  CHEMICAL
  PACKAGING
  OTHER
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  // Set when the owner hands out a password; cleared once the employee picks their own.
  mustChangePassword Boolean  @default(false)
  // Sidebar tabs granted to this one person on top of their role, e.g. ["/waste"].
  extraTabs          String[] @default([])
  createdAt          DateTime @default(now())
  // When the owner last added or edited this login; orders the Employees list.
  updatedAt          DateTime @default(now())

  inwards        MaterialInward[]
  qcRecords      QCRecord[]
  purchaseOrders PurchaseOrder[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  createdAt DateTime @default(now())

  inwards        MaterialInward[]
  purchaseOrders PurchaseOrder[]
  materials      RawMaterial[]
}

model Buyer {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  orders     Order[]
  dispatches Dispatch[]
}

model RawMaterial {
  id           String           @id @default(cuid())
  category     MaterialCategory @default(YARN)
  yarnType     String
  colour       String
  unit         String           @default("kg")
  qtyInStock   Decimal          @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal          @default(0) @db.Decimal(12, 2)
  avgCost      Decimal          @default(0) @db.Decimal(12, 2)
  // Config: who it is usually bought from and how many days a delivery takes.
  supplierId   String?
  leadDays     Int              @default(7)
  createdAt    DateTime         @default(now())

  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inwards        MaterialInward[]
  issues         MaterialIssue[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  fabricSpecs    FabricSpec[]

  @@unique([yarnType, colour])
}

// Yarn arriving at the gate
model MaterialInward {
  id           String   @id @default(cuid())
  materialId   String
  supplierId   String
  orderId      String?
  receivedById String
  qty          Decimal  @db.Decimal(12, 2)
  rate         Decimal  @db.Decimal(12, 2)
  billAmount   Decimal  @db.Decimal(14, 2)
  receivedAt   DateTime @default(now())

  material      RawMaterial    @relation(fields: [materialId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  receivedBy    User           @relation(fields: [receivedById], references: [id])
  purchaseOrder PurchaseOrder?

  @@index([materialId])
  @@index([receivedAt])
}

// Material ordered from a supplier. It reaches stock only when the store marks it received,
// which records a MaterialInward.
model PurchaseOrder {
  id          String              @id @default(cuid())
  poNo        String              @unique
  materialId  String
  supplierId  String
  orderedById String
  qty         Decimal             @db.Decimal(12, 2)
  rate        Decimal             @db.Decimal(12, 2)
  status      PurchaseOrderStatus @default(PENDING)
  orderedAt   DateTime            @default(now())
  receivedAt  DateTime?
  inwardId    String?             @unique

  material  RawMaterial     @relation(fields: [materialId], references: [id])
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  orderedBy User            @relation(fields: [orderedById], references: [id])
  inward    MaterialInward? @relation(fields: [inwardId], references: [id])

  @@index([status])
}

// Material leaving the store. Yarn goes to an order and drives its cost; dyes, chemicals
// and packaging can be used without naming an order.
model MaterialIssue {
  id         String   @id @default(cuid())
  materialId String
  orderId    String?
  qty        Decimal  @db.Decimal(12, 2)
  cost       Decimal  @db.Decimal(14, 2)
  issuedAt   DateTime @default(now())

  material RawMaterial @relation(fields: [materialId], references: [id])
  order    Order?      @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  trackingToken String      @unique @default(cuid())
  buyerId       String
  materialId    String?
  fabricType    String
  colour        String
  qty           Decimal     @db.Decimal(12, 2)
  yarnRequired  Decimal     @default(0) @db.Decimal(12, 2)
  pricePerUnit  Decimal     @default(0) @db.Decimal(12, 2)
  // The Config figures this order was taken with, kept so later Config edits don't rewrite it.
  yarnPerMetre  Decimal?    @db.Decimal(8, 4)
  wastagePct    Decimal?    @db.Decimal(5, 2)
  listPrice     Decimal?    @db.Decimal(12, 2)
  deadline      DateTime
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  buyer      Buyer            @relation(fields: [buyerId], references: [id])
  material   RawMaterial?     @relation(fields: [materialId], references: [id])
  inwards    MaterialInward[]
  issues     MaterialIssue[]
  jobs       ProductionJob[]
  rolls      Roll[]
  dispatches Dispatch[]

  @@index([status])
  @@index([deadline])
}

model Machine {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      Stage
  status    MachineStatus @default(IDLE)
  createdAt DateTime      @default(now())

  jobs  ProductionJob[]
  rolls Roll[]
  logs  ProductionLog[]
}

// One order running one stage on one machine
model ProductionJob {
  id          String    @id @default(cuid())
  orderId     String
  machineId   String
  workerId    String?
  stage       Stage
  shift       Shift
  status      JobStatus @default(RUNNING)
  qtyPlanned  Decimal   @db.Decimal(12, 2)
  qtyProduced Decimal   @default(0) @db.Decimal(12, 2)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  order   Order           @relation(fields: [orderId], references: [id])
  machine Machine         @relation(fields: [machineId], references: [id])
  worker  Worker?         @relation(fields: [workerId], references: [id])
  rolls   Roll[]
  logs    ProductionLog[]

  @@index([orderId])
  @@index([machineId, status])
  @@index([startedAt])
}

// Each quantity reported against a job — drives per-day machine output
model ProductionLog {
  id        String   @id @default(cuid())
  jobId     String
  machineId String
  qty       Decimal  @db.Decimal(12, 2)
  loggedAt  DateTime @default(now())

  job     ProductionJob @relation(fields: [jobId], references: [id])
  machine Machine       @relation(fields: [machineId], references: [id])

  @@index([machineId, loggedAt])
}

model Roll {
  id         String     @id @default(cuid())
  rollNo     String     @unique
  orderId    String
  machineId  String
  jobId      String?
  dispatchId String?
  qty        Decimal    @db.Decimal(12, 2)
  status     RollStatus @default(PENDING_QC)
  createdAt  DateTime   @default(now())

  order     Order          @relation(fields: [orderId], references: [id])
  machine   Machine        @relation(fields: [machineId], references: [id])
  job       ProductionJob? @relation(fields: [jobId], references: [id])
  dispatch  Dispatch?      @relation(fields: [dispatchId], references: [id])
  qcRecords QCRecord[]

  @@index([orderId])
  @@index([status])
}

model QCRecord {
  id          String   @id @default(cuid())
  rollId      String
  inspectorId String
  result      QCResult
  defectType  String?
  notes       String?
  checkedAt   DateTime @default(now())

  roll      Roll @relation(fields: [rollId], references: [id])
  inspector User @relation(fields: [inspectorId], references: [id])

  @@index([rollId])
}

model Dispatch {
  id           String   @id @default(cuid())
  dispatchNo   String   @unique
  orderId      String
  buyerId      String
  vehicleNo    String?
  dispatchedAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id])
  buyer   Buyer    @relation(fields: [buyerId], references: [id])
  rolls   Roll[]
  invoice Invoice?

  @@index([orderId])
}

model Invoice {
  id         String        @id @default(cuid())
  invoiceNo  String        @unique
  dispatchId String        @unique
  amount     Decimal       @db.Decimal(14, 2)
  status     InvoiceStatus @default(UNPAID)
  issuedAt   DateTime      @default(now())

  dispatch Dispatch  @relation(fields: [dispatchId], references: [id])
  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  method    String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paidAt])
}

model Worker {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  shift     Shift
  dailyWage Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  attendance Attendance[]
  wages      WagePayment[]
  jobs       ProductionJob[]
}

model Attendance {
  id       String           @id @default(cuid())
  workerId String
  date     DateTime         @db.Date
  shift    Shift
  status   AttendanceStatus

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
  @@index([date])
}

model WagePayment {
  id       String   @id @default(cuid())
  workerId String
  month    String // YYYY-MM
  amount   Decimal  @db.Decimal(12, 2)
  paidAt   DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, month])
}

// ---------------------------------------------------------------- config --
// Figures the owner sets on the Config page instead of them being fixed in code.

enum RuleKind {
  QUANTITY // an order smaller than `below` metres
  DEADLINE // a deadline fewer than `below` days away
}

// Per fabric: the yarn it is made from, net yarn per metre, expected waste and the usual price.
// Yarn to issue = metres x yarnPerMetre x (1 + wastage %).
model FabricSpec {
  id            String   @id @default(cuid())
  fabricType    String   @unique
  materialId    String?
  yarnPerMetre  Decimal  @db.Decimal(8, 4)
  wastagePct    Decimal  @default(0) @db.Decimal(5, 2)
  pricePerMetre Decimal  @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  material RawMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
}

// Adjustments for small or rushed orders, added on top of the fabric's figures.
model OrderRule {
  id         String   @id @default(cuid())
  kind       RuleKind
  below      Int
  pricePct   Decimal  @default(0) @db.Decimal(5, 2)
  wastagePct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@unique([kind, below])
}

// Mill-wide numbers (QC days, roll length, shift hours...). A missing key uses its default.
model Setting {
  key       String   @id
  value     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

// Every config edit: who changed what, from and to.
model ConfigChange {
  id        String   @id @default(cuid())
  what      String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())

  @@index([changedAt])
}
