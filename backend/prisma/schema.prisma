generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STORE
  PRODUCTION
  QC
  DISPATCH
}

enum Shift {
  MORNING
  EVENING
  NIGHT
}

enum Stage {
  SPINNING
  WEAVING
  DYEING
}

enum OrderStatus {
  PENDING
  SPINNING
  WEAVING
  DYEING
  QC
  READY
  DISPATCHED
  CANCELLED
}

enum MachineStatus {
  IDLE
  RUNNING
  BREAKDOWN
  MAINTENANCE
}

enum JobStatus {
  RUNNING
  COMPLETED
  STOPPED
}

enum RollStatus {
  PENDING_QC
  PASSED
  REWORK
  REJECTED
  DISPATCHED
}

enum QCResult {
  PASS
  REWORK
  REJECT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

// Yarn is what orders are made from; the rest is what the mill uses up along the way.
// Store sections. One item lives in one section; use by several departments is recorded on
// each MaterialIssue (department), never by duplicating the item.
enum MaterialCategory {
  YARN
  WEAVING // sizing agents, loom lubricants, loom cleaners
  DYEING // dyes and dyeing chemicals
  FINISHING // softeners, fixing and finishing agents
  QC // testing reagents, sample labels
  PACKAGING // tubes, wraps, covers, labels, straps, cartons
  MAINTENANCE // machine oil and grease, belts, bearings, spares, cleaning
}

enum ExpenseCategory {
  LOGISTICS
  UTILITIES
}

enum ExpenseStatus {
  PAID
  UNPAID
  ACCRUED // used and owed, bill not received yet
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  // Set when the owner hands out a password; cleared once the employee picks their own.
  mustChangePassword Boolean  @default(false)
  // Sidebar tabs granted to this one person on top of their role, e.g. ["/waste"].
  extraTabs          String[] @default([])
  // Optional: the shift this person usually works.
  shift              Shift?
  createdAt          DateTime @default(now())
  // When the owner last added or edited this login; orders the Employees list.
  updatedAt          DateTime @default(now())

  inwards        MaterialInward[]
  qcRecords      QCRecord[]
  purchaseOrders PurchaseOrder[]
}

model Supplier {
  id         String   @id @default(cuid())
  name       String   @unique
  phone      String?
  // GST place of supply: Gujarat = CGST+SGST, elsewhere IGST. No GSTIN is stored.
  state      String   @default("Gujarat")
  creditDays Int      @default(30)
  createdAt  DateTime @default(now())

  inwards        MaterialInward[]
  purchaseOrders PurchaseOrder[]
  materials      RawMaterial[]
  expenses       Expense[]
}

model Buyer {
  id         String   @id @default(cuid())
  name       String   @unique
  phone      String?
  email      String?
  state      String   @default("Gujarat")
  creditDays Int      @default(30)
  createdAt  DateTime @default(now())

  orders     Order[]
  dispatches Dispatch[]
}

model RawMaterial {
  id           String           @id @default(cuid())
  category     MaterialCategory @default(YARN)
  yarnType     String
  colour       String
  unit         String           @default("kg")
  qtyInStock   Decimal          @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal          @default(0) @db.Decimal(12, 2)
  avgCost      Decimal          @default(0) @db.Decimal(12, 2)
  // Config: who it is usually bought from and how many days a delivery takes.
  supplierId   String?
  leadDays     Int              @default(7)
  sku          String?          @unique
  subcategory  String? // e.g. "Sizing agents", "Reactive dyes"
  department   String? // the department that mainly uses it
  taxCode      String? // GST rule in backend/src/lib/tax.js
  // Maintenance spares are capitalised-in-store and expensed on issue; consumables go to order cost.
  isSpare      Boolean          @default(false)
  createdAt    DateTime         @default(now())

  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inwards        MaterialInward[]
  issues         MaterialIssue[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  fabricSpecs    FabricSpec[]

  @@unique([yarnType, colour])
}

// Yarn arriving at the gate
model MaterialInward {
  id           String    @id @default(cuid())
  materialId   String
  supplierId   String
  orderId      String?
  receivedById String
  qty          Decimal   @db.Decimal(12, 2)
  rate         Decimal   @db.Decimal(12, 2)
  billAmount   Decimal   @db.Decimal(14, 2) // taxable value = qty x rate
  receivedAt   DateTime  @default(now())
  // The supplier's bill for this delivery: one delivery, one bill line.
  billNo       String?
  dueDate      DateTime?
  batchNo      String?
  // GST (backend/src/lib/tax.js). totalAmount = what is payable; null on rows from before GST
  // fields existed, where it equals the pre-tax amount.
  taxCode      String?
  taxRatePct   Decimal   @default(0) @db.Decimal(5, 2)
  taxTreatment String? // NIL, INTRA, INTER, EXEMPT, NON_GST, RCM_INTRA, RCM_INTER
  cgst         Decimal   @default(0) @db.Decimal(14, 2)
  sgst         Decimal   @default(0) @db.Decimal(14, 2)
  igst         Decimal   @default(0) @db.Decimal(14, 2)
  itcEligible  Boolean   @default(false)
  totalAmount  Decimal?  @db.Decimal(14, 2)

  material      RawMaterial       @relation(fields: [materialId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  order         Order?            @relation(fields: [orderId], references: [id])
  receivedBy    User              @relation(fields: [receivedById], references: [id])
  purchaseOrder PurchaseOrder?
  payments      SupplierPayment[]

  @@index([materialId])
  @@index([receivedAt])
}

// Material ordered from a supplier. It reaches stock only when the store marks it received,
// which records a MaterialInward.
model PurchaseOrder {
  id          String              @id @default(cuid())
  poNo        String              @unique
  materialId  String
  supplierId  String
  orderedById String
  qty         Decimal             @db.Decimal(12, 2)
  rate        Decimal             @db.Decimal(12, 2)
  status      PurchaseOrderStatus @default(PENDING)
  orderedAt   DateTime            @default(now())
  receivedAt  DateTime?
  inwardId    String?             @unique

  material  RawMaterial     @relation(fields: [materialId], references: [id])
  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  orderedBy User            @relation(fields: [orderedById], references: [id])
  inward    MaterialInward? @relation(fields: [inwardId], references: [id])

  @@index([status])
}

// Material leaving the store. Yarn goes to an order and drives its cost; dyes, chemicals
// and packaging can be used without naming an order.
model MaterialIssue {
  id         String   @id @default(cuid())
  materialId String
  orderId    String?
  jobId      String? // the production job it was used on
  department String? // SPINNING, WEAVING, DYEING, FINISHING, QC, DISPATCH, MAINTENANCE
  qty        Decimal  @db.Decimal(12, 2)
  cost       Decimal  @db.Decimal(14, 2)
  issuedAt   DateTime @default(now())

  material RawMaterial    @relation(fields: [materialId], references: [id])
  order    Order?         @relation(fields: [orderId], references: [id])
  job      ProductionJob? @relation(fields: [jobId], references: [id])

  @@index([orderId])
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  trackingToken String      @unique @default(cuid())
  buyerId       String
  materialId    String?
  fabricType    String
  colour        String
  qty           Decimal     @db.Decimal(12, 2)
  yarnRequired  Decimal     @default(0) @db.Decimal(12, 2)
  pricePerUnit  Decimal     @default(0) @db.Decimal(12, 2)
  // The Config figures this order was taken with, kept so later Config edits don't rewrite it.
  yarnPerMetre  Decimal?    @db.Decimal(8, 4)
  wastagePct    Decimal?    @db.Decimal(5, 2)
  listPrice     Decimal?    @db.Decimal(12, 2)
  deadline      DateTime
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  buyer      Buyer            @relation(fields: [buyerId], references: [id])
  material   RawMaterial?     @relation(fields: [materialId], references: [id])
  inwards    MaterialInward[]
  issues     MaterialIssue[]
  jobs       ProductionJob[]
  rolls      Roll[]
  dispatches Dispatch[]
  expenses   Expense[]

  @@index([status])
  @@index([deadline])
}

model Machine {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      Stage
  status    MachineStatus @default(IDLE)
  // What it can make in a day: kg for spinning, metres for weaving and dyeing. Optional on old machines.
  dailyCapacity Decimal?  @db.Decimal(12, 2)
  // Set when a machine with past jobs is removed in Mill Setup: off the floor, kept for its records.
  removedAt DateTime?
  createdAt DateTime      @default(now())

  jobs  ProductionJob[]
  rolls Roll[]
  logs  ProductionLog[]
}

// One order running one stage on one machine
model ProductionJob {
  id          String    @id @default(cuid())
  orderId     String
  machineId   String
  workerId    String?
  stage       Stage
  shift       Shift
  status      JobStatus @default(RUNNING)
  qtyPlanned  Decimal   @db.Decimal(12, 2)
  qtyProduced Decimal   @default(0) @db.Decimal(12, 2)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  order   Order           @relation(fields: [orderId], references: [id])
  machine Machine         @relation(fields: [machineId], references: [id])
  worker  Worker?         @relation(fields: [workerId], references: [id])
  rolls   Roll[]
  logs    ProductionLog[]
  issues  MaterialIssue[]

  @@index([orderId])
  @@index([machineId, status])
  @@index([startedAt])
}

// Each quantity reported against a job — drives per-day machine output
model ProductionLog {
  id        String   @id @default(cuid())
  jobId     String
  machineId String
  qty       Decimal  @db.Decimal(12, 2)
  loggedAt  DateTime @default(now())

  job     ProductionJob @relation(fields: [jobId], references: [id])
  machine Machine       @relation(fields: [machineId], references: [id])

  @@index([machineId, loggedAt])
}

model Roll {
  id         String     @id @default(cuid())
  rollNo     String     @unique
  orderId    String
  machineId  String
  jobId      String?
  dispatchId String?
  qty        Decimal    @db.Decimal(12, 2)
  status     RollStatus @default(PENDING_QC)
  createdAt  DateTime   @default(now())

  order     Order          @relation(fields: [orderId], references: [id])
  machine   Machine        @relation(fields: [machineId], references: [id])
  job       ProductionJob? @relation(fields: [jobId], references: [id])
  dispatch  Dispatch?      @relation(fields: [dispatchId], references: [id])
  qcRecords QCRecord[]

  @@index([orderId])
  @@index([status])
}

model QCRecord {
  id          String   @id @default(cuid())
  rollId      String
  inspectorId String
  result      QCResult
  defectType  String?
  notes       String?
  checkedAt   DateTime @default(now())

  roll      Roll @relation(fields: [rollId], references: [id])
  inspector User @relation(fields: [inspectorId], references: [id])

  @@index([rollId])
}

model Dispatch {
  id           String   @id @default(cuid())
  dispatchNo   String   @unique
  orderId      String
  buyerId      String
  vehicleNo    String?
  dispatchedAt DateTime @default(now())

  order    Order     @relation(fields: [orderId], references: [id])
  buyer    Buyer     @relation(fields: [buyerId], references: [id])
  rolls    Roll[]
  invoice  Invoice?
  expenses Expense[]

  @@index([orderId])
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String        @unique
  dispatchId   String        @unique // one invoice per dispatch: a truck cannot be billed twice
  amount       Decimal       @db.Decimal(14, 2) // taxable value = dispatched metres x order price
  status       InvoiceStatus @default(UNPAID)
  issuedAt     DateTime      @default(now())
  dueDate      DateTime?
  // GST (backend/src/lib/tax.js). totalAmount = what is payable; null on rows from before GST
  // fields existed, where it equals the pre-tax amount.
  taxCode      String?
  taxRatePct   Decimal       @default(0) @db.Decimal(5, 2)
  taxTreatment String? // NIL, INTRA, INTER, EXEMPT, NON_GST, RCM_INTRA, RCM_INTER
  cgst         Decimal       @default(0) @db.Decimal(14, 2)
  sgst         Decimal       @default(0) @db.Decimal(14, 2)
  igst         Decimal       @default(0) @db.Decimal(14, 2)
  itcEligible  Boolean       @default(false)
  totalAmount  Decimal?      @db.Decimal(14, 2)

  dispatch Dispatch  @relation(fields: [dispatchId], references: [id])
  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(14, 2)
  method    String?
  reference String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paidAt])
}

model Worker {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  shift      Shift
  dailyWage  Decimal  @db.Decimal(10, 2)
  // Crews rotate across spinning, weaving and dyeing, so floor workers sit in one department.
  department String   @default("Production floor")
  isActive   Boolean  @default(true)
  // Set when a worker with past attendance or wages is removed in Mill Setup: off every list,
  // but the old registers and payslips still point at them.
  removedAt  DateTime?
  createdAt  DateTime @default(now())

  attendance Attendance[]
  wages      WagePayment[]
  jobs       ProductionJob[]
}

model Attendance {
  id       String           @id @default(cuid())
  workerId String
  date     DateTime         @db.Date
  shift    Shift
  status   AttendanceStatus

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
  @@index([date])
}

model WagePayment {
  id         String   @id @default(cuid())
  workerId   String
  month      String // YYYY-MM
  amount     Decimal  @db.Decimal(12, 2) // net paid
  paidAt     DateTime @default(now())
  // Payslip (backend/src/lib/payroll.js); null on payments recorded before these fields.
  daysWorked Decimal? @db.Decimal(5, 1)
  basic      Decimal? @db.Decimal(12, 2)
  allowances Decimal? @db.Decimal(12, 2)
  overtime   Decimal? @db.Decimal(12, 2)
  deductions Decimal? @db.Decimal(12, 2)
  gross      Decimal? @db.Decimal(12, 2)

  worker Worker @relation(fields: [workerId], references: [id])

  @@unique([workerId, month])
}

// ---------------------------------------------------------------- config --
// Figures the owner sets on the Config page instead of them being fixed in code.

enum RuleKind {
  QUANTITY // an order smaller than `below` metres
  DEADLINE // a deadline fewer than `below` days away
}

// Per fabric: the yarn it is made from, net yarn per metre, expected waste and the usual price.
// Yarn to issue = metres x yarnPerMetre x (1 + wastage %).
model FabricSpec {
  id            String   @id @default(cuid())
  fabricType    String   @unique
  materialId    String?
  yarnPerMetre  Decimal  @db.Decimal(8, 4)
  wastagePct    Decimal  @default(0) @db.Decimal(5, 2)
  pricePerMetre Decimal  @db.Decimal(12, 2)
  // Removed in Mill Setup while past orders still use the name: kept so it stays off the list.
  hidden        Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  material RawMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
}

// Adjustments for small or rushed orders, added on top of the fabric's figures.
model OrderRule {
  id         String   @id @default(cuid())
  kind       RuleKind
  below      Int
  pricePct   Decimal  @default(0) @db.Decimal(5, 2)
  wastagePct Decimal  @default(0) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@unique([kind, below])
}

// Mill-wide numbers (QC days, roll length, shift hours...). A missing key uses its default.
model Setting {
  key       String   @id
  value     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

// Every config edit: who changed what, from and to.
model ConfigChange {
  id        String   @id @default(cuid())
  what      String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())

  @@index([changedAt])
}

// --------------------------------------------------------------- accounts --

// Money paid to a supplier against a delivery's bill (MaterialInward).
model SupplierPayment {
  id        String   @id @default(cuid())
  inwardId  String
  amount    Decimal  @db.Decimal(14, 2)
  method    String?
  reference String?
  paidAt    DateTime @default(now())

  inward MaterialInward @relation(fields: [inwardId], references: [id])

  @@index([paidAt])
  @@index([inwardId])
}

// Logistics and factory-utility spending. Materials bought into the store are never booked here
// (they are MaterialInward bills), so nothing is counted twice.
model Expense {
  id           String          @id @default(cuid())
  voucherNo    String          @unique
  category     ExpenseCategory
  subcategory  String
  description  String
  supplierId   String?
  payee        String
  incurredAt   DateTime
  dueDate      DateTime?
  amount       Decimal         @db.Decimal(14, 2) // taxable value
  status       ExpenseStatus   @default(UNPAID)
  paidAt       DateTime?
  method       String?
  reference    String?
  costCentre   String // e.g. Dispatch, Fleet, Utilities, Dyeing house
  orderId      String?
  dispatchId   String?
  recurring    Boolean         @default(false)
  // GST (backend/src/lib/tax.js). totalAmount = what is payable; null on rows from before GST
  // fields existed, where it equals the pre-tax amount.
  taxCode      String?
  taxRatePct   Decimal         @default(0) @db.Decimal(5, 2)
  taxTreatment String? // NIL, INTRA, INTER, EXEMPT, NON_GST, RCM_INTRA, RCM_INTER
  cgst         Decimal         @default(0) @db.Decimal(14, 2)
  sgst         Decimal         @default(0) @db.Decimal(14, 2)
  igst         Decimal         @default(0) @db.Decimal(14, 2)
  itcEligible  Boolean         @default(false)
  totalAmount  Decimal?        @db.Decimal(14, 2)
  createdAt    DateTime        @default(now())

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  dispatch Dispatch? @relation(fields: [dispatchId], references: [id])

  @@index([incurredAt])
  @@index([category])
}

// Every money edit made in the app: payments, expense changes, cancellations.
model AuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  action   String
  detail   String?
  by       String
  at       DateTime @default(now())

  @@index([entity, entityId])
}
